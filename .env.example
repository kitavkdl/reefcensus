# Copy to .env (never commit .env) and fill in your key from the Meta developer console.
META_API_KEY=
# Hard cap in USD on total API spend recorded in cache/ledger.jsonl. A full discovery run on a 12 s clip is ~$0.05-0.25.
FISH_BUDGET=1.0
# Optional: Muse Spark model id (default muse-spark-1.3)
# FISH_SPARK_MODEL=muse-spark-1.3
